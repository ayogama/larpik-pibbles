local function createSkateBtn(text, pos, rot, parent, bgColor, textColor)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 260, 0, 65)
	btn.Position = pos
	btn.Rotation = rot
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.BackgroundColor3 = bgColor or Color3.fromRGB(0, 255, 255) -- Default Neon Cyan
	btn.Font = Enum.Font.GothamBlack
	btn.TextSize = 30
	btn.TextColor3 = textColor or Color3.fromRGB(10, 10, 10)
	btn.Text = text
	btn.Parent = parent

	-- Street art drop shadow
	local shadow = Instance.new("Frame")
	shadow.Size = UDim2.new(1, 0, 1, 0)
	shadow.Position = UDim2.new(0, 6, 0, 6)
	shadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	shadow.ZIndex = btn.ZIndex - 1
	shadow.Parent = btn

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.1, Enum.EasingStyle.Bounce), {Rotation = rot * -1.5, Size = UDim2.new(0, 275, 0, 70)}):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {Rotation = rot, Size = UDim2.new(0, 260, 0, 65)}):Play()
	end)
	btn.MouseButton1Click:Connect(function() sfx_grow:Play() end)

	return btn
end

