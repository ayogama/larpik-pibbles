-- ==========================================
-- PHASE 3: GAMEPLAY & DYNAMIC GRADIENT
-- ==========================================
local towerFolder = workspace:FindFirstChild("StackTower") or Instance.new("Folder")
towerFolder.Name = "StackTower"
towerFolder.Parent = workspace

local baseBlock, currentBlock, previousBlock
local movingZ = true
local isMoving = false
local gameState = "Menu" 
local score = 0
local perfectStreak = 0
local speed = 25
local camTargetY = 0
local currentCamY = 0
local camOffset = Vector3.new(-18, 16, -18) 
local moveDir = 1
local travelDistance = 16
local positionOffset = -travelDistance
local startHue = 0 
local menuTime = 0 -- Timer for animations

local function getBlockColor(index)
	local currentHue = (startHue + (index * 0.015)) % 1
	return Color3.fromHSV(currentHue, 0.8, 0.9)
end

-- Cinematic Menu Tower Generator
local function buildMenuTower()
	towerFolder:ClearAllChildren()
	startHue = math.random()

	local dBase = Instance.new("Part")
	dBase.Anchored = true
	dBase.Size = Vector3.new(10, 1, 10)
	dBase.Position = Vector3.new(0, 0, 0)
	dBase.Color = Color3.fromRGB(20, 20, 20)
	dBase.Material = Enum.Material.SmoothPlastic
	dBase.Parent = towerFolder

	local cY = 1
	local cSize = 10
	for i = 1, 20 do
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = Vector3.new(cSize, 1, cSize)
		-- Messy, artistic stack
		p.Position = Vector3.new(math.sin(i * 0.5) * 0.8, cY, math.cos(i * 0.5) * 0.8) 
		p.Color = getBlockColor(i)
		p.Material = Enum.Material.SmoothPlastic
		p.Parent = towerFolder
		cY = cY + 1
		cSize = cSize - 0.2
	end
end

local function createShockwave(block)
	local wave = Instance.new("Part")
	wave.Anchored = true
	wave.CanCollide = false
	wave.Material = Enum.Material.Neon
	wave.Color = block.Color
	wave.Size = Vector3.new(block.Size.X + 0.1, 0.1, block.Size.Z + 0.1)
	wave.Position = block.Position
	wave.Parent = workspace

	local tw = TweenService:Create(wave, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(block.Size.X + 8, 0.1, block.Size.Z + 8),
		Transparency = 1
	})
	tw:Play()
	tw.Completed:Connect(function() wave:Destroy() end)
end

local function popComboText(streak)
	comboLabel.Text = "STREAK x" .. streak
	comboLabel.TextTransparency = 0
	comboStroke.Transparency = 0
	comboLabel.Position = UDim2.new(0, 0, 0.25, 0)

	local tw = TweenService:Create(comboLabel, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0.2, 0)})
	tw:Play()

	task.delay(1, function()
		if perfectStreak == streak then 
			TweenService:Create(comboLabel, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
			TweenService:Create(comboStroke, TweenInfo.new(0.2), {Transparency = 1}):Play()
		end
	end)
end

local function spawnBlock()
	local newBlock = Instance.new("Part")
	newBlock.Anchored = true
	newBlock.Material = Enum.Material.SmoothPlastic
	newBlock.Color = getBlockColor(score)
	newBlock.Size = previousBlock.Size

	local startY = previousBlock.Position.Y + previousBlock.Size.Y
	if movingZ then
		newBlock.Position = Vector3.new(previousBlock.Position.X, startY, previousBlock.Position.Z - travelDistance)
	else
		newBlock.Position = Vector3.new(previousBlock.Position.X - travelDistance, startY, previousBlock.Position.Z)
	end

	newBlock.Parent = towerFolder
	currentBlock = newBlock
	positionOffset = -travelDistance
	moveDir = 1
	isMoving = true
end

local function initGame()
	towerFolder:ClearAllChildren()
	score = 0
	perfectStreak = 0
	speed = 25
	movingZ = true
	camTargetY = 0
	currentCamY = 0
	startHue = math.random() 

	scoreLabel.Text = "0"
	comboLabel.TextTransparency = 1
	comboStroke.Transparency = 1

	menuPanel.Visible = false
	overPanel.Visible = false
	hudPanel.Visible = true
	gameState = "Playing"

	baseBlock = Instance.new("Part")
	baseBlock.Name = "BaseBlock"
	baseBlock.Anchored = true
	baseBlock.Size = Vector3.new(10, 1, 10)
	baseBlock.Position = Vector3.new(0, 0, 0)
	baseBlock.Color = Color3.fromRGB(20, 20, 20)
	baseBlock.Material = Enum.Material.SmoothPlastic
	baseBlock.Parent = towerFolder

	previousBlock = baseBlock
	spawnBlock()
end

local function triggerGameOver()
	sfx_over:Play()
	gameState = "GameOver"
	isMoving = false
	saveEvent:FireServer(score)
	leaderboardText.Text = "HIGH SCORE: " .. player.leaderstats.HighScore.Value

	overPanel.BackgroundTransparency = 1
	overPanel.Visible = true
	TweenService:Create(overPanel, TweenInfo.new(0.5), {BackgroundTransparency = 0.4}):Play()
end

local function placeBlock()
	if not currentBlock then return false end
	isMoving = false 

	local distance, overlap, newSize, newPos, chopSize, chopPos
	local snapTolerance = 0.5 
	local isPerfect = false

	if movingZ then
		distance = currentBlock.Position.Z - previousBlock.Position.Z
		if math.abs(distance) >= previousBlock.Size.Z then return false end 

		if math.abs(distance) <= snapTolerance then 
			distance = 0 
			isPerfect = true
		end

		overlap = previousBlock.Size.Z - math.abs(distance)
		newSize = Vector3.new(currentBlock.Size.X, currentBlock.Size.Y, overlap)
		newPos = Vector3.new(currentBlock.Position.X, currentBlock.Position.Y, previousBlock.Position.Z + (distance / 2))

		if distance ~= 0 then
			chopSize = Vector3.new(currentBlock.Size.X, currentBlock.Size.Y, math.abs(distance))
			chopPos = Vector3.new(currentBlock.Position.X, currentBlock.Position.Y, currentBlock.Position.Z + (distance > 0 and overlap/2 or -overlap/2))
		end
	else
		distance = currentBlock.Position.X - previousBlock.Position.X
		if math.abs(distance) >= previousBlock.Size.X then return false end 

		if math.abs(distance) <= snapTolerance then 
			distance = 0 
			isPerfect = true
		end

		overlap = previousBlock.Size.X - math.abs(distance)
		newSize = Vector3.new(overlap, currentBlock.Size.Y, currentBlock.Size.Z)
		newPos = Vector3.new(previousBlock.Position.X + (distance / 2), currentBlock.Position.Y, currentBlock.Position.Z)

		if distance ~= 0 then
			chopSize = Vector3.new(math.abs(distance), currentBlock.Size.Y, currentBlock.Size.Z)
			chopPos = Vector3.new(currentBlock.Position.X + (distance > 0 and overlap/2 or -overlap/2), currentBlock.Position.Y, currentBlock.Position.Z)
		end
	end

	currentBlock.Size = newSize
	currentBlock.Position = newPos

	if isPerfect then
		perfectStreak = perfectStreak + 1
		createShockwave(currentBlock)
		popComboText(perfectStreak)

		sfx_perfect.Pitch = 1 + (math.min(perfectStreak, 15) * 0.1)
		sfx_perfect:Play()

		if perfectStreak >= 3 then
			local maxAllowed = 10 
			local growth = 0.5
			local expandedSize = Vector3.new(
				math.min(maxAllowed, currentBlock.Size.X + growth),
				currentBlock.Size.Y,
				math.min(maxAllowed, currentBlock.Size.Z + growth)
			)
			TweenService:Create(currentBlock, TweenInfo.new(0.3, Enum.EasingStyle.Bounce), {Size = expandedSize}):Play()
			currentBlock.Size = expandedSize 
		end
	else
		perfectStreak = 0
		sfx_place.Pitch = 1 + (math.min(score, 30) * 0.01)
		sfx_place:Play()
	end

	if distance ~= 0 then
		local chop = Instance.new("Part")
		chop.Size = chopSize
		chop.Position = chopPos
		chop.Color = currentBlock.Color
		chop.Material = Enum.Material.SmoothPlastic
		chop.Anchored = false
		chop.Parent = workspace
		task.delay(3, function() chop:Destroy() end)
	end

	previousBlock = currentBlock
	movingZ = not movingZ
	speed = speed + 0.5 
	score = score + 1
	camTargetY = currentBlock.Position.Y

	scoreLabel.Text = tostring(score)
	TweenService:Create(scoreLabel, TweenInfo.new(0.1, Enum.EasingStyle.Quint), {TextSize = 120}):Play()
	task.delay(0.1, function() TweenService:Create(scoreLabel, TweenInfo.new(0.2), {TextSize = 90}):Play() end)

	return true
end

-- ==========================================
-- INPUT & LOOP ENGINE
-- ==========================================
tapButton.MouseButton1Down:Connect(function()
	if gameState ~= "Playing" then return end
	if placeBlock() then
		spawnBlock()
	else
		triggerGameOver()
	end
end)

btnPlay.MouseButton1Click:Connect(initGame)
btnRestart.MouseButton1Click:Connect(initGame)
btnMenu.MouseButton1Click:Connect(function()
	overPanel.Visible = false
	hudPanel.Visible = false
	menuPanel.Visible = true
	gameState = "Menu"
	buildMenuTower()
end)

btnRevive.MouseButton1Click:Connect(function() game:GetService("MarketplaceService"):PromptProductPurchase(player, REVIVE_PRODUCT_ID) end)

reviveEvent.OnClientEvent:Connect(function()
	overPanel.Visible = false
	gameState = "Playing"
	perfectStreak = 0 
	currentBlock.Position = Vector3.new(previousBlock.Position.X, currentBlock.Position.Y, previousBlock.Position.Z)
	placeBlock()
	spawnBlock()
end)

RunService.RenderStepped:Connect(function(dt)
	camera.CameraType = Enum.CameraType.Scriptable

	-- Cinematic Menu Camera
	if gameState == "Menu" then
		camera.FieldOfView = 90 -- Fisheye lens effect
		menuTime = menuTime + dt
		local radius = 28
		local cx = math.sin(menuTime * 0.4) * radius
		local cz = math.cos(menuTime * 0.4) * radius
		camera.CFrame = CFrame.lookAt(Vector3.new(cx, 12, cz), Vector3.new(0, 8, 0))

		-- Title Bouncing & Throbbing
		title.Rotation = math.sin(menuTime * 5) * 4
		titleShadow.Rotation = title.Rotation
		titleScale.Scale = 1 + math.sin(menuTime * 8) * 0.05
		return
	end

	-- Normal Game Camera
	camera.FieldOfView = 70
	currentCamY = currentCamY + (camTargetY - currentCamY) * 10 * dt 
	local targetPos = Vector3.new(0, currentCamY, 0)
	camera.CFrame = CFrame.lookAt(targetPos + camOffset, targetPos)

	if gameState ~= "Playing" or not isMoving or not currentBlock then return end

	positionOffset = positionOffset + (speed * dt * moveDir)
	if positionOffset > travelDistance then
		positionOffset = travelDistance
		moveDir = -1
	elseif positionOffset < -travelDistance then
		positionOffset = -travelDistance
		moveDir = 1
	end

	if movingZ then
		currentBlock.Position = Vector3.new(previousBlock.Position.X, currentBlock.Position.Y, previousBlock.Position.Z + positionOffset)
	else
		currentBlock.Position = Vector3.new(previousBlock.Position.X + positionOffset, currentBlock.Position.Y, previousBlock.Position.Z)
	end
end)

-- Start up the cinematic menu!
buildMenuTower()